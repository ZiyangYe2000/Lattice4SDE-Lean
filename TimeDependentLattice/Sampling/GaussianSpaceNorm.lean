import Mathlib.MeasureTheory.Function.ConditionalExpectation.Real
import TimeDependentLattice.Sampling.DerivativeMoment

/-!
# The Gaussian-space component `B_u`

Equation (5.1) is represented invariantly as the `L²` norm of the conditional expectation with
respect to the coordinates in `u`.  Under the hybrid product law, the normalization of the
Laplace coordinates contributes the factor `α^(-|u|/2)`.  The Jensen step in paper Lemma 5.2 is
then the standard `L²` contraction property of conditional expectation.
-/

namespace TimeDependentLattice.Sampling

noncomputable section

open scoped ENNReal
open MeasureTheory ProbabilityTheory
open TimeDependentLattice.Analysis TimeDependentLattice.BrownianBridge
  TimeDependentLattice.Euler TimeDependentLattice.Regularity TimeDependentLattice.Trees

/-- The sub-σ-algebra generated by the coordinate projections belonging to `support`. -/
@[instance_reducible]
def activeCoordinateMeasurableSpace
    {ι : Type*} [Fintype ι] [DecidableEq ι] (support : Finset ι) :
    MeasurableSpace (ι → ℝ) :=
  MeasurableSpace.comap
    (fun z : ι → ℝ => fun j : ↥support => z j.1) inferInstance

theorem activeCoordinateMeasurableSpace_le
    {ι : Type*} [Fintype ι] [DecidableEq ι] (support : Finset ι) :
    activeCoordinateMeasurableSpace support ≤
      (inferInstance : MeasurableSpace (ι → ℝ)) := by
  unfold activeCoordinateMeasurableSpace
  have h : Measurable
      (fun z : ι → ℝ => fun j : ↥support => z j.1) := by
    fun_prop
  exact h.comap_le

/-- Conditional-expectation form of the paper quantity `B_u(F)` from Equation (5.1).

The measure is the hybrid product law: Gaussian off `support` and Laplace with density
`α exp(-2 α |z|)` on `support`.  Multiplication by `α^(-|support|/2)` removes the Laplace
normalization inside the squared `L²` norm. -/
def gaussianSpaceComponent
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (support : Finset ι) (α : ℝ) (f : (ι → ℝ) → ℝ) : ℝ :=
  let μ := hybridProductMeasure support α
  α ^ (-((support.card : ℝ) / 2)) *
    lpNorm (μ[f | activeCoordinateMeasurableSpace support]) 2 μ

theorem gaussianSpaceComponent_nonneg
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (support : Finset ι) {α : ℝ} (hα : 0 ≤ α) (f : (ι → ℝ) → ℝ) :
    0 ≤ gaussianSpaceComponent support α f := by
  unfold gaussianSpaceComponent
  exact mul_nonneg (Real.rpow_nonneg hα _) lpNorm_nonneg

/-- Jensen's inequality in the proof of Lemma 5.2, expressed as the `L²` contraction of
conditional expectation.  The assumption `α ≥ 1` also removes the normalization factor. -/
theorem gaussianSpaceComponent_le_lpNorm
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (support : Finset ι) {α : ℝ} (hα : 1 ≤ α)
    (f : (ι → ℝ) → ℝ)
    (hf : MemLp f 2 (hybridProductMeasure support α)) :
    gaussianSpaceComponent support α f ≤
      lpNorm f 2 (hybridProductMeasure support α) := by
  have hfactor : α ^ (-((support.card : ℝ) / 2)) ≤ 1 :=
    Real.rpow_le_one_of_one_le_of_nonpos hα
      (neg_nonpos.mpr (div_nonneg (Nat.cast_nonneg _) (by norm_num)))
  have hcond := hf.lpNorm_condExp_le_lpNorm
    (m := activeCoordinateMeasurableSpace support)
    (by norm_num : (1 : ℝ≥0∞) ≤ 2)
  unfold gaussianSpaceComponent
  calc
    α ^ (-((support.card : ℝ) / 2)) *
        lpNorm
          ((hybridProductMeasure support α)[f |
            activeCoordinateMeasurableSpace support]) 2
          (hybridProductMeasure support α) ≤
        1 * lpNorm
          ((hybridProductMeasure support α)[f |
            activeCoordinateMeasurableSpace support]) 2
          (hybridProductMeasure support α) := by
      apply mul_le_mul_of_nonneg_right hfactor
      exact lpNorm_nonneg
    _ ≤ lpNorm f 2 (hybridProductMeasure support α) := by
      simpa using hcond

/-- Paper Lemma 5.2 for the dyadic Euler integrand, with `B_u` represented by
`gaussianSpaceComponent` and with the exact constant `sqrt C_aux` used in the paper. -/
theorem lemma5_2
    {J stateDim noiseDim : ℕ}
    {drift : Drift stateDim} {diffusion : Diffusion stateDim noiseDim}
    {payoff : Payoff stateDim} {T K₀ : ℝ}
    (bounds : GevreyBounds drift payoff T) (hT : 0 < T) (hK₀ : 0 ≤ K₀)
    (x₀ : State stateDim) (support : Finset (Index J noiseDim))
    (hsupport : support.Nonempty)
    (hdrift : ∀ z : Index J noiseDim → ℝ, ∀ i < numSteps J,
      ‖drift (gridTime T J i)
          (stateNat drift diffusion T x₀ (bridgeInput z) i)‖ ≤
        K₀ + bounds.driftLipschitzConstant *
          ‖stateNat drift diffusion T x₀ (bridgeInput z) i‖) :
    gaussianSpaceComponent support
        (hybridAlpha bounds.β T bounds.driftLipschitzConstant
          (diffusionThetaOne diffusion))
        (fun z : Index J noiseDim → ℝ =>
          mixedDerivative (integrand drift diffusion payoff T x₀) support
            (bridgeInput z)) ≤
      Real.sqrt
          (auxiliaryMomentConstant bounds.β T K₀ bounds.driftLipschitzConstant
            ‖x₀‖ (diffusionThetaOne diffusion)) *
        normalizedDerivativeEnvelope
          drift diffusion payoff T bounds.β x₀ support := by
  let α₀ := hybridAlpha bounds.β T bounds.driftLipschitzConstant
    (diffusionThetaOne diffusion)
  let f : (Index J noiseDim → ℝ) → ℝ := fun z =>
    mixedDerivative (integrand drift diffusion payoff T x₀) support (bridgeInput z)
  have hα₀ : 1 ≤ α₀ := one_le_hybridAlpha bounds.β_pos.le
    (diffusionThetaOne_nonneg diffusion)
  have hf : MemLp f 2 (hybridProductMeasure support α₀) := by
    simpa [f, α₀] using mixedDerivative_eulerIntegrand_memLp_two
      bounds hT hK₀ x₀ support hsupport hdrift
  calc
    gaussianSpaceComponent support α₀ f ≤
        lpNorm f 2 (hybridProductMeasure support α₀) :=
      gaussianSpaceComponent_le_lpNorm support hα₀ f hf
    _ ≤ Real.sqrt
          (auxiliaryMomentConstant bounds.β T K₀ bounds.driftLipschitzConstant
            ‖x₀‖ (diffusionThetaOne diffusion)) *
        normalizedDerivativeEnvelope
          drift diffusion payoff T bounds.β x₀ support := by
      simpa [f, α₀] using lpNorm_mixedDerivative_eulerIntegrand_le
        bounds hT hK₀ x₀ support hsupport hdrift

end

end TimeDependentLattice.Sampling
